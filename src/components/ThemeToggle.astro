---
import Icon from './Icon.astro';
---
<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" title="Switch to dark theme">
  <span class="theme-toggle-icon"><Icon name="sun" size={20} class="theme-sun"/><Icon name="moon" size={20} class="theme-moon"/></span>
  <span class="theme-toggle-label">Light</span>
</button>
